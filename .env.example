# Copy to .env and fill in. .env is git-ignored. The key stays on the server only.

# Optional. Without it the app works and "Polish with Claude" is disabled.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=claude-sonnet-5-5

# Optional. Defaults to 3000.
PORT=3000

# Optional. Defaults to 127.0.0.1 (this machine only). Use 0.0.0.0 to test from a phone on your Wi-Fi
# (no service worker or install over plain http on a LAN IP; use a tunnel for that, see README).
HOST=127.0.0.1
